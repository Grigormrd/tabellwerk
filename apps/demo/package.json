{
  "name": "demo",
  "private": true,
  "description": "Tabellwerk demo: German electricity market data from SMARD in the data grid",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node ../../scripts/serve-static.mjs dist 6008",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "record": "node scripts/record-smard.mjs",
    "record:preview": "playwright test --config playwright.record.config.ts && node ../../scripts/preview-gif.mjs test-results/preview.webm ../../docs/media/preview.gif"
  },
  "dependencies": {
    "@tabellwerk/react": "workspace:^",
    "@tabellwerk/tokens": "workspace:^",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
