{
  "$description": "Mode-independent tokens: spacing, shape, typography, sizing and motion.",
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.375rem" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "Liberation Mono", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "0.8125rem" },
      "md": { "$value": "0.875rem" },
      "lg": { "$value": "1rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "normal": { "$value": 1.5 }
    }
  },
  "size": {
    "$type": "dimension",
    "row": { "$value": "2.25rem", "$description": "Default data grid row height." },
    "control": { "$value": "2.25rem", "$description": "Height of inputs and buttons." },
    "focus-ring": { "$value": "2px" },
    "focus-offset": { "$value": "2px" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" }
  }
}
